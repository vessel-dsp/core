schema: circuit-interchange/v3
metadata:
  name: Klon-Style Charge Pump Power Topology
  description: Minimal synthetic charge-pump domain exercising converter identity.
  partNumber: ""
source:
  format: interchange
  filename: charge-pump-derived-rails-valid.vdsp
components:
  - id: BATT1
    kind: battery
    name: BATT1
    origin:
      x: 0
      y: 0
    rotation: 0
    flipped: false
    terminals:
      - name: "+"
        position:
          x: 0
          y: -10
      - name: "-"
        position:
          x: 0
          y: 10
    properties:
      V:
        raw: "9V"
        value: 9
        unit: V
  - id: RAIL_MAIN
    kind: port
    name: RAIL_MAIN
    origin:
      x: 0
      y: 30
    rotation: 0
    flipped: false
    terminals:
      - name: t
        position:
          x: 0
          y: 30
    properties: {}
  - id: U_CP
    kind: power-converter
    name: U_CP
    sourceTypeName: Circuit.PowerConverter
    origin:
      x: 40
      y: 30
    rotation: 0
    flipped: false
    terminals:
      - name: vin
        position:
          x: 30
          y: 30
      - name: ground
        position:
          x: 40
          y: 40
      - name: voutPositive
        position:
          x: 50
          y: 20
      - name: voutNegative
        position:
          x: 50
          y: 40
    properties:
      ConverterKind: charge-pump
      PartNumber: MAX1044
      Description: "Source-visible charge pump that derives +V2 and V- from +V."
  - id: RAIL_PLUS2
    kind: port
    name: RAIL_PLUS2
    origin:
      x: 80
      y: 20
    rotation: 0
    flipped: false
    terminals:
      - name: t
        position:
          x: 80
          y: 20
    properties: {}
  - id: RAIL_MINUS
    kind: port
    name: RAIL_MINUS
    origin:
      x: 80
      y: 40
    rotation: 0
    flipped: false
    terminals:
      - name: t
        position:
          x: 80
          y: 40
    properties: {}
wires: []
directives: []
diagnostics: []
rawAttributes: {}
power:
  schema: circuit-power/v1
  coverage: explicit-topology
  domains:
    - id: klon-charge-pump-domain
      sourceComponentIds:
        - BATT1
      ratedVoltage:
        raw: "9V"
        value: 9
        unit: V
      groundPolarity: bipolar
      sourceKind: external-dc
      rails:
        - railComponentId: RAIL_MAIN
          role: main-supply
          derivation: direct
        - railComponentId: RAIL_PLUS2
          role: charge-pump-output
          derivation: doubler
          converterComponentId: U_CP
          parentRailComponentId: RAIL_MAIN
          nominalVoltage:
            raw: "18V"
            value: 18
            unit: V
        - railComponentId: RAIL_MINUS
          role: negative-supply
          derivation: inverter
          converterComponentId: U_CP
          parentRailComponentId: RAIL_MAIN
          nominalVoltage:
            raw: "-9V"
            value: -9
            unit: V
