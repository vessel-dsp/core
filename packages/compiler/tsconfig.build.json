{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022"],
		"exactOptionalPropertyTypes": false,
		"noUncheckedIndexedAccess": false,
		"noEmit": false,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "src",
		"baseUrl": "../..",
		"paths": {
			"@vessel-dsp/core": ["packages/core/dist/index.d.ts"],
			"@vessel-dsp/core/*": ["packages/core/dist/*"]
		}
	},
	"include": ["src/**/*"]
}
