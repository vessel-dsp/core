{
	"name": "@vessel-dsp/control-ui",
	"version": "0.6.13",
	"description": "React control-surface components for VesselDSP panel data.",
	"keywords": [
		"guitar-pedal",
		"electronics",
		"react",
		"controls",
		"vdsp"
	],
	"homepage": "https://vessel-dsp.github.io/core/",
	"bugs": {
		"url": "https://github.com/vessel-dsp/core/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vessel-dsp/core.git"
	},
	"license": "MIT",
	"sideEffects": [
		"./dist/styles.css",
		"./src/styles.css"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"bun": "./dist/index.js",
			"import": "./dist/index.js"
		},
		"./styles.css": {
			"default": "./dist/styles.css"
		},
		"./package.json": {
			"default": "./package.json"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && bun run ../../scripts/fix-dist-imports.ts dist && cp src/styles.css dist/styles.css",
		"clean": "rm -rf dist",
		"prepack": "bun run build",
		"pack:dry-run": "npm pack --dry-run",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@vessel-dsp/core": "0.6.13"
	},
	"peerDependencies": {
		"react": ">=18.2 <20",
		"react-dom": ">=18.2 <20"
	},
	"devDependencies": {
		"@types/react": "^18.3.18",
		"@types/react-dom": "^18.3.5",
		"@types/react-test-renderer": "^18.3.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-test-renderer": "^18.3.1"
	},
	"publishConfig": {
		"access": "public"
	}
}
