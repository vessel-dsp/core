{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "baseUrl": "../..",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "jsx": "react-jsx",
        "paths": {
