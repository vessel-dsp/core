{
	"name": "@vessel-dsp/chain",
	"version": "0.1.0",
	"description": "Headless audio signal chain graph engine for VesselDSP circuits, guitar profiling, NAM, and cabinet IRs.",
	"keywords": [
		"dsp",
		"audio",
		"signal-chain",
		"guitar",
		"nam",
		"ir",
		"impulse-response",
		"vessel-dsp"
	],
	"homepage": "https://vessel-dsp.github.io/core/",
	"bugs": {
		"url": "https://github.com/vessel-dsp/core/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vessel-dsp/core.git"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"bun": "./dist/index.js",
			"import": "./dist/index.js"
		},
		"./package.json": {
			"default": "./package.json"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && bun run ../../scripts/fix-dist-imports.ts dist",
		"clean": "rm -rf dist",
		"prepack": "bun run build",
		"pack:dry-run": "npm pack --dry-run",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@vessel-dsp/compiler": "0.1.0",
		"@vessel-dsp/core": "0.7.2",
		"@vessel-dsp/runtime": "0.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
