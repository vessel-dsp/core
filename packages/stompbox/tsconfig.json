{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": [
            "ES2022"
        ],
        "baseUrl": "../..",
        "paths": {
            "@vessel-dsp/core": [
                "packages/core/src/index.ts"
            ],
            "@vessel-dsp/core/*": [
                "packages/core/src/*"
            ],
            "@vessel-dsp/stompbox": [
                "packages/stompbox/src/index.ts"
            ],
            "@vessel-dsp/stompbox/*": [
                "packages/stompbox/src/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ]
}
