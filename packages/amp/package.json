{
	"name": "@vessel-dsp/amp",
	"version": "0.6.10",
	"description": "Generated Three.js and GLB previews for amplifier profile visualization.",
	"keywords": [
		"amp",
		"amplifier",
		"threejs",
		"glb",
		"visualization"
	],
	"homepage": "https://vessel-dsp.github.io/core/",
	"bugs": {
		"url": "https://github.com/vessel-dsp/core/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vessel-dsp/core.git"
	},
	"license": "MIT",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"bun": "./dist/index.js",
			"import": "./dist/index.js"
		},
		"./package.json": {
			"default": "./package.json"
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && bun run ../../scripts/fix-dist-imports.ts dist",
		"clean": "rm -rf dist",
		"prepack": "bun run build",
		"pack:dry-run": "npm pack --dry-run",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@vessel-dsp/core": "0.6.10",
		"@vessel-dsp/visual-effects": "0.6.10",
		"three": "^0.184.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
