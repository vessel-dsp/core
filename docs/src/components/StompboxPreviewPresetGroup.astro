---
type StompboxPreviewPreset = {
	id?: string;
	label: string;
	src: string;
	view?: "orbit" | "top";
	interactive?: boolean;
	linework?: boolean;
	lineworkColor?: string;
	backgroundColor?: string;
	gridColor?: string;
	gridOpacity?: number;
	toon?: boolean;
	toonEdgeColor?: string;
	grain?: boolean;
	grainScale?: number;
	grainIntensity?: number;
	crt?: boolean;
	crtCurvature?: number;
	crtScanlineIntensity?: number;
	crtScanlineCount?: number;
	crtVignette?: number;
	crtRgbShift?: number;
	crtFlicker?: number;
	crtBrightness?: number;
	crtContrast?: number;
	crtSaturation?: number;
	crtBloomIntensity?: number;
	crtBloomThreshold?: number;
	glitch?: boolean;
	glitchInterval?: number;
	drillTemplateSrc?: string;
	drillLayoutSrc?: string;
};

type Props = {
	presets: readonly StompboxPreviewPreset[];
	label?: string;
};

const props = Astro.props;
const normalizedPresets = props.presets.map((preset, index) => ({
	id: preset.id ?? `preset-${index + 1}`,
	label: preset.label,
	src: preset.src,
	...(preset.view === undefined ? {} : { view: preset.view }),
	...(preset.interactive === undefined
		? {}
		: { interactive: preset.interactive }),
	...(preset.linework === undefined ? {} : { linework: preset.linework }),
	...(preset.lineworkColor === undefined
		? {}
		: { lineworkColor: preset.lineworkColor }),
	...(preset.backgroundColor === undefined
		? {}
		: { backgroundColor: preset.backgroundColor }),
	...(preset.gridColor === undefined ? {} : { gridColor: preset.gridColor }),
	...(preset.gridOpacity === undefined
		? {}
		: { gridOpacity: preset.gridOpacity }),
	...(preset.toon === undefined ? {} : { toon: preset.toon }),
	...(preset.toonEdgeColor === undefined
		? {}
		: { toonEdgeColor: preset.toonEdgeColor }),
	...(preset.grain === undefined ? {} : { grain: preset.grain }),
	...(preset.grainScale === undefined ? {} : { grainScale: preset.grainScale }),
	...(preset.grainIntensity === undefined
		? {}
		: { grainIntensity: preset.grainIntensity }),
	...(preset.crt === undefined ? {} : { crt: preset.crt }),
	...(preset.crtCurvature === undefined
		? {}
		: { crtCurvature: preset.crtCurvature }),
	...(preset.crtScanlineIntensity === undefined
		? {}
		: { crtScanlineIntensity: preset.crtScanlineIntensity }),
	...(preset.crtScanlineCount === undefined
		? {}
		: { crtScanlineCount: preset.crtScanlineCount }),
	...(preset.crtVignette === undefined
		? {}
		: { crtVignette: preset.crtVignette }),
	...(preset.crtRgbShift === undefined
		? {}
		: { crtRgbShift: preset.crtRgbShift }),
	...(preset.crtFlicker === undefined ? {} : { crtFlicker: preset.crtFlicker }),
	...(preset.crtBrightness === undefined
		? {}
		: { crtBrightness: preset.crtBrightness }),
	...(preset.crtContrast === undefined
		? {}
		: { crtContrast: preset.crtContrast }),
	...(preset.crtSaturation === undefined
		? {}
		: { crtSaturation: preset.crtSaturation }),
	...(preset.crtBloomIntensity === undefined
		? {}
		: { crtBloomIntensity: preset.crtBloomIntensity }),
	...(preset.crtBloomThreshold === undefined
		? {}
		: { crtBloomThreshold: preset.crtBloomThreshold }),
	...(preset.glitch === undefined ? {} : { glitch: preset.glitch }),
	...(preset.glitchInterval === undefined
		? {}
		: { glitchInterval: preset.glitchInterval }),
	...(preset.drillTemplateSrc === undefined
		? {}
		: { drillTemplateSrc: preset.drillTemplateSrc }),
	...(preset.drillLayoutSrc === undefined
		? {}
		: { drillLayoutSrc: preset.drillLayoutSrc }),
}));
const presetsJson = JSON.stringify(normalizedPresets);
const label = props.label ?? "Preview preset";
const initialEffects = normalizedPresets[0] ?? {};
const effectEnabled = (name: string) => initialEffects[name] === true;
---

<section
	class="stompbox-preview-preset-group"
	data-stompbox-preview-preset-group
	data-stompbox-presets={presetsJson}
>
	<div class="stompbox-preview-preset-group__toolbar">
		<label class="stompbox-preview-preset-group__control">
			<span>{label}:</span>
			<select data-stompbox-preset-select aria-label={label}>
				{normalizedPresets.map((preset) => (
					<option value={preset.id}>{preset.label}</option>
				))}
			</select>
		</label>
	</div>
	<div class="stompbox-preview-preset-group__effects" data-stompbox-effect-controls>
		<label>
			<input
				type="checkbox"
				data-effect-toggle="toon"
				checked={effectEnabled("toon")}
			/>
			<span>Toon edge</span>
		</label>
		<label>
			<input
				type="checkbox"
				data-effect-toggle="grain"
				checked={effectEnabled("grain")}
			/>
			<span>Grain</span>
		</label>
		<label>
			<input
				type="checkbox"
				data-effect-toggle="glitch"
				checked={effectEnabled("glitch")}
			/>
			<span>Glitch</span>
		</label>
		<label>
			<input
				type="checkbox"
				data-effect-toggle="crt"
				checked={effectEnabled("crt")}
			/>
			<span>CRT</span>
		</label>
	</div>
	<div
		class="stompbox-preview-preset-group__live-state"
		data-stompbox-live-state-controls
		hidden
	></div>
	<slot />
</section>

<style>
	.stompbox-preview-preset-group {
		margin: 1.25rem 0 1.75rem;
	}

	.stompbox-preview-preset-group__toolbar {
		display: flex;
		margin: 0.25rem 0 0.45rem;
	}

	.stompbox-preview-preset-group__effects {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		align-content: flex-start;
		gap: 0.45rem;
		margin: 0 0 1rem;
	}

	.stompbox-preview-preset-group__effects label {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		box-sizing: border-box;
		height: 2rem;
		padding: 0 0.55rem;
		border: 1px solid #cbd5e1;
		border-radius: 6px;
		background: #ffffff;
		color: #0f172a;
		font-size: 0.8125rem;
		font-weight: 650;
		line-height: 1;
		margin: 0;
		white-space: nowrap;
	}

	.stompbox-preview-preset-group__effects input {
		appearance: none;
		display: grid;
		flex: 0 0 auto;
		place-content: center;
		width: 1rem;
		height: 1rem;
		margin: 0;
		border: 1px solid #22c55e;
		border-radius: 3px;
		background: transparent;
	}

	.stompbox-preview-preset-group__effects input::before {
		content: "";
		width: 0.55rem;
		height: 0.35rem;
		border: solid #052e16;
		border-width: 0 0 2px 2px;
		opacity: 0;
		transform: translateY(-0.05rem) rotate(-45deg);
	}

	.stompbox-preview-preset-group__effects input:checked {
		background: #22c55e;
	}

	.stompbox-preview-preset-group__effects input:checked::before {
		opacity: 1;
	}

	.stompbox-preview-preset-group__effects span {
		line-height: 1;
	}

	.stompbox-preview-preset-group__live-state {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
		gap: 0.6rem;
		margin: -0.3rem 0 1rem;
		padding: 0.7rem;
		border: 1px solid #cbd5e1;
		border-radius: 8px;
		background: #f8fafc;
		color: #0f172a;
		font-size: 0.8125rem;
		line-height: 1.25;
	}

	.stompbox-preview-preset-group__live-state[hidden] {
		display: none;
	}

	.stompbox-preview-preset-group__control {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		max-width: 100%;
		padding: 0.45rem 0.55rem;
		line-height: 1.2;
	}

	.stompbox-preview-preset-group__control span {
		font-weight: 600;
		white-space: nowrap;
	}

	.stompbox-preview-preset-group__control select {
		min-width: min(16rem, 58vw);
		max-width: 100%;
		border: 1px solid #cbd5e1;
		border-radius: 4px;
		background: #ffffff;
		color: #0f172a;
		font: inherit;
		line-height: 1.2;
		padding: 0.25rem 1.8rem 0.25rem 0.45rem;
	}

	:global(.stompbox-live-state-control) {
		display: grid;
		gap: 0.3rem;
	}

	:global(.stompbox-live-state-control__label) {
		overflow-wrap: anywhere;
		font-weight: 650;
	}

	:global(.stompbox-live-state-toggle) {
		grid-template-columns: auto 1fr;
		align-items: center;
		column-gap: 0.5rem;
	}

	:global(.stompbox-live-state-control input[type="range"]) {
		width: 100%;
		accent-color: #2563eb;
	}

	:global(.stompbox-live-state-toggle input[type="checkbox"]) {
		width: 1.05rem;
		height: 1.05rem;
		accent-color: #16a34a;
	}

	:global(.stompbox-live-state-control button) {
		width: 100%;
		min-height: 2rem;
		border: 1px solid #94a3b8;
		border-radius: 6px;
		background: #ffffff;
		color: #0f172a;
		font: inherit;
		font-weight: 650;
		cursor: pointer;
	}

	:global(.stompbox-live-state-control button[aria-pressed="true"]) {
		border-color: #15803d;
		background: #dcfce7;
		color: #14532d;
	}
</style>
