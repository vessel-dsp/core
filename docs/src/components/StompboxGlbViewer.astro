---
type Props = {
	src: string;
	label?: string;
	height?: string;
};

const {
	src,
	label = "Interactive 3D stompbox preview",
	height = "360px",
} = Astro.props;
---

<figure
	class="stompbox-glb-viewer"
	data-stompbox-glb-viewer
	data-glb-src={src}
	style={`--stompbox-viewer-height: ${height};`}
>
	<canvas aria-label={label}></canvas>
	<div class="stompbox-glb-viewer__status" data-stompbox-glb-status>
		Loading 3D preview
	</div>
</figure>

<script type="importmap">
	{
		"imports": {
			"three": "/core/vendor/three/build/three.module.js",
			"three/addons/": "/core/vendor/three/addons/"
		}
	}
</script>
<script type="module" src="/core/stompbox-glb-viewer.js"></script>

<style>
	.stompbox-glb-viewer {
		position: relative;
		width: 100%;
		height: var(--stompbox-viewer-height);
		min-height: 280px;
		margin: 1rem 0;
		overflow: hidden;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 8px;
		background: #f8fafc;
	}

	.stompbox-glb-viewer canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.stompbox-glb-viewer__status {
		position: absolute;
		inset: auto 1rem 1rem 1rem;
		padding: 0.45rem 0.65rem;
		border-radius: 6px;
		background: rgb(15 23 42 / 0.82);
		color: #f8fafc;
		font-size: 0.8125rem;
		line-height: 1.3;
		pointer-events: none;
	}
</style>
