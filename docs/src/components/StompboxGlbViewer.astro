---
type Props = {
	src: string;
	label?: string;
	height?: string;
	view?: "orbit" | "top";
	interactive?: boolean;
	linework?: boolean;
	lineworkColor?: string;
	backgroundColor?: string;
	gridColor?: string;
	gridOpacity?: number;
	toon?: boolean;
	toonEdgeColor?: string;
	grain?: boolean;
	grainScale?: number;
	grainIntensity?: number;
	crt?: boolean;
	crtCurvature?: number;
	crtScanlineIntensity?: number;
	crtScanlineCount?: number;
	crtVignette?: number;
	crtRgbShift?: number;
	crtFlicker?: number;
	crtBrightness?: number;
	crtContrast?: number;
	crtSaturation?: number;
	crtBloomIntensity?: number;
	crtBloomThreshold?: number;
	glitch?: boolean;
	glitchInterval?: number;
	liveStateDemo?: boolean;
};

const props = Astro.props;
const src = props.src;
const view = props.view ?? "orbit";
const interactive = props.interactive ?? view !== "top";
const linework = props.linework ?? false;
const lineworkColor = props.lineworkColor ?? "#111827";
const backgroundColor = props.backgroundColor ?? "#000000";
const gridColor = props.gridColor ?? "#cccccc";
const gridOpacity = props.gridOpacity ?? 0.2;
const toon = props.toon ?? false;
const toonEdgeColor = props.toonEdgeColor ?? "#69145a";
const grain = props.grain ?? false;
const grainScale = props.grainScale ?? 1.15;
const grainIntensity = props.grainIntensity ?? 0.05;
const crt = props.crt ?? false;
const crtCurvature = props.crtCurvature ?? 0.15;
const crtScanlineIntensity = props.crtScanlineIntensity ?? 0.2;
const crtScanlineCount = props.crtScanlineCount ?? 500;
const crtVignette = props.crtVignette ?? 0.75;
const crtRgbShift = props.crtRgbShift ?? 1;
const crtFlicker = props.crtFlicker ?? 0.05;
const crtBrightness = props.crtBrightness ?? 1;
const crtContrast = props.crtContrast ?? 0.95;
const crtSaturation = props.crtSaturation ?? 0.96;
const crtBloomIntensity = props.crtBloomIntensity ?? 0.5;
const crtBloomThreshold = props.crtBloomThreshold ?? 0.75;
const glitch = props.glitch ?? false;
const glitchInterval = props.glitchInterval ?? 8;
const liveStateDemo = props.liveStateDemo ?? false;
const label =
	props.label ??
	(view === "top"
		? "Orthographic top stompbox preview"
		: "Interactive 3D stompbox preview");
const height = props.height ?? "360px";
---

<figure
	class="stompbox-glb-viewer"
	data-stompbox-glb-viewer
	data-glb-src={src}
	data-view-mode={view}
	data-interactive={interactive ? "true" : "false"}
	data-linework={linework ? "true" : "false"}
	data-linework-color={lineworkColor}
	data-background-color={backgroundColor}
	data-grid-color={gridColor}
	data-grid-opacity={String(gridOpacity)}
	data-toon={toon ? "true" : "false"}
	data-toon-edge-color={toonEdgeColor}
	data-grain={grain ? "true" : "false"}
	data-grain-scale={String(grainScale)}
	data-grain-intensity={String(grainIntensity)}
	data-crt={crt ? "true" : "false"}
	data-crt-curvature={String(crtCurvature)}
	data-crt-scanline-intensity={String(crtScanlineIntensity)}
	data-crt-scanline-count={String(crtScanlineCount)}
	data-crt-vignette={String(crtVignette)}
	data-crt-rgb-shift={String(crtRgbShift)}
	data-crt-flicker={String(crtFlicker)}
	data-crt-brightness={String(crtBrightness)}
	data-crt-contrast={String(crtContrast)}
	data-crt-saturation={String(crtSaturation)}
	data-crt-bloom-intensity={String(crtBloomIntensity)}
	data-crt-bloom-threshold={String(crtBloomThreshold)}
	data-glitch={glitch ? "true" : "false"}
	data-glitch-interval={String(glitchInterval)}
	data-live-state-demo={liveStateDemo ? "true" : "false"}
	style={`--stompbox-viewer-height: ${height}; --stompbox-viewer-background-color: ${backgroundColor}; --stompbox-viewer-grid-color: ${gridColor}; --stompbox-viewer-grid-opacity: ${gridOpacity};`}
>
	<canvas aria-label={label}></canvas>
	<div class="stompbox-glb-viewer__status" data-stompbox-glb-status>
		Loading 3D preview
	</div>
</figure>

<script type="importmap">
	{
		"imports": {
			"three": "/core/vendor/three/build/three.module.js",
			"three/addons/": "/core/vendor/three/addons/",
			"@vessel-dsp/visual-effects": "/core/vendor/vessel-dsp/visual-effects/index.js"
		}
	}
</script>
<script type="module" src="/core/stompbox-glb-viewer.js"></script>

<style>
	.stompbox-glb-viewer {
		position: relative;
		width: 100%;
		height: var(--stompbox-viewer-height);
		min-height: 280px;
		margin: 1rem 0;
		overflow: hidden;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 8px;
		background: var(--stompbox-viewer-background-color, #000000);
	}

	.stompbox-glb-viewer::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 0;
		background-image:
			linear-gradient(to right, var(--stompbox-viewer-grid-color, #cccccc) 1px, transparent 1px),
			linear-gradient(to bottom, var(--stompbox-viewer-grid-color, #cccccc) 1px, transparent 1px);
		background-size: 24px 24px;
		opacity: var(--stompbox-viewer-grid-opacity, 0.1);
		pointer-events: none;
	}

	.stompbox-glb-viewer canvas {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		height: 100%;
	}

	.stompbox-glb-viewer__status {
		position: absolute;
		inset: auto 1rem 1rem 1rem;
		padding: 0.45rem 0.65rem;
		border-radius: 6px;
		background: rgb(15 23 42 / 0.82);
		color: #f8fafc;
		font-size: 0.8125rem;
		line-height: 1.3;
		pointer-events: none;
		z-index: 2;
	}

</style>
