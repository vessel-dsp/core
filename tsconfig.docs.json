{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"exactOptionalPropertyTypes": false,
		"noUncheckedIndexedAccess": false,
		"baseUrl": ".",
		"paths": {
			"@vessel-dsp/core": ["packages/core/src/index.ts"],
			"@vessel-dsp/core/*": ["packages/core/src/*"],
			"@vessel-dsp/stompbox": ["packages/stompbox/src/index.ts"],
			"@vessel-dsp/stompbox/node": ["packages/stompbox/src/node.ts"],
			"@vessel-dsp/stompbox/*": ["packages/stompbox/src/*"],
			"@vessel-dsp/control-ui": ["packages/control-ui/src/index.ts"],
			"@vessel-dsp/control-ui/*": ["packages/control-ui/src/*"],
			"@vessel-dsp/visual-effects": [
				"packages/visual-effects/src/index.ts"
			],
			"@vessel-dsp/visual-effects/*": ["packages/visual-effects/src/*"],
			"@vessel-dsp/amp": ["packages/amp/src/index.ts"],
			"@vessel-dsp/amp/*": ["packages/amp/src/*"],
			"@vessel-dsp/cabinet": ["packages/cabinet/src/index.ts"],
			"@vessel-dsp/cabinet/*": ["packages/cabinet/src/*"],
			"@vessel-dsp/compiler": ["packages/compiler/src/index.ts"],
			"@vessel-dsp/compiler/*": ["packages/compiler/src/*"],
			"@vessel-dsp/runtime": ["packages/runtime/src/index.ts"],
			"@vessel-dsp/runtime/*": ["packages/runtime/src/*"],
			"@vessel-dsp/chain": ["packages/chain/src/index.ts"],
			"@vessel-dsp/chain/*": ["packages/chain/src/*"]
		}
	},
	"include": [
		"packages/core/src/index.ts",
		"packages/stompbox/src/index.ts",
		"packages/control-ui/src/index.ts",
		"packages/visual-effects/src/index.ts",
		"packages/amp/src/index.ts",
		"packages/cabinet/src/index.ts",
		"packages/compiler/src/index.ts",
		"packages/runtime/src/index.ts",
		"packages/chain/src/index.ts"
	]
}
